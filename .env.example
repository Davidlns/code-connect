# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env de verdade — ele já está no .gitignore.

# Conexão COM pool — usada pela aplicação em runtime (src/prisma/db.js).
# Em dev local (Docker), pode ser a mesma URL do banco direto.
# Em produção (Vercel), use a connection string com pooler (ex: PgBouncer/pgbouncer=true).
DATABASE_URL="postgresql://postgres@localhost:5432/codeconnect_dev"

# Conexão DIRETA (sem pool) — usada só pelo Prisma CLI (migrate, generate).
# Migrations não funcionam corretamente através de um pooler.
# Em dev local, pode ser idêntica à DATABASE_URL. Em produção, use a URL
# direta que seu provedor de Postgres fornece (ex: POSTGRES_URL_NON_POOLING na Vercel).
DIRECT_URL="postgresql://postgres@localhost:5432/codeconnect_dev"
